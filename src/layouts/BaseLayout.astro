---
import '../styles/global.css';
import type { PortfolioContent } from '../content';

interface Props {
  content: PortfolioContent;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { content, noindex = false } = Astro.props;
const { projects: projectsContent, site: siteContent } = content;
const { title, description } = siteContent;
const image = Astro.props.image ?? siteContent.socialImage.path;
const imageAlt = Astro.props.imageAlt ?? siteContent.socialImage.alt;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const portugueseURL = new URL('/', Astro.site ?? Astro.url.origin);
const englishURL = new URL('/en/', Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
const sitemapURL = new URL('sitemap-index.xml', Astro.site ?? Astro.url.origin);
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const projectEntities = projectsContent.items.map((project) => ({
  '@type': 'CreativeWork',
  name: project.title,
  description: project.description,
  dateCreated: project.year,
  keywords: project.stack.join(', '),
  ...(project.projectUrl ? { url: project.projectUrl } : {}),
  ...(project.repositoryUrl ? { sameAs: project.repositoryUrl } : {}),
}));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ImageObject',
      '@id': `${canonicalURL.origin}/#primaryimage`,
      url: socialImage.href,
      contentUrl: socialImage.href,
      width: siteContent.socialImage.width,
      height: siteContent.socialImage.height,
      caption: imageAlt,
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL.origin}/#website`,
      url: `${canonicalURL.origin}/`,
      name: siteContent.name,
      description: siteContent.description,
      inLanguage: siteContent.language,
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: title,
      description,
      inLanguage: siteContent.language,
      isPartOf: { '@id': `${canonicalURL.origin}/#website` },
      primaryImageOfPage: { '@id': `${canonicalURL.origin}/#primaryimage` },
      mainEntity: { '@id': `${canonicalURL.origin}/#person` },
      hasPart: projectEntities,
    },
    {
      '@type': 'Person',
      '@id': `${canonicalURL.origin}/#person`,
      name: siteContent.name,
      url: `${canonicalURL.origin}/`,
      image: { '@id': `${canonicalURL.origin}/#primaryimage` },
      jobTitle: siteContent.jobTitle,
      sameAs: siteContent.sameAs,
      knowsAbout: siteContent.keywords,
    },
  ],
};
---

<!doctype html>
<html lang={siteContent.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ currentLocale: siteContent.language }}>
      try {
        const storageKey = 'portfolio-locale';
        const savedLocale = window.localStorage.getItem(storageKey);
        if (currentLocale === 'pt-BR' && savedLocale === 'en' && window.location.pathname === '/') {
          window.location.replace(`/en/${window.location.search}${window.location.hash}`);
        } else {
          window.localStorage.setItem(storageKey, currentLocale);
        }
      } catch {
        // The selected URL remains authoritative when browser storage is unavailable.
      }
    </script>
    <meta name="description" content={description} />
    <meta name="author" content={siteContent.author} />
    <meta name="keywords" content={siteContent.keywords.join(', ')} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content={siteContent.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pt-BR" href={portugueseURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="x-default" href={portugueseURL} />
    <link rel="sitemap" href={sitemapURL} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={siteContent.appTitle} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteContent.locale} />
    <meta
      property="og:locale:alternate"
      content={siteContent.locale === 'pt_BR' ? 'en_US' : 'pt_BR'}
    />
    <meta property="og:site_name" content={siteContent.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(siteContent.socialImage.width)} />
    <meta property="og:image:height" content={String(siteContent.socialImage.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:url" content={socialImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

    <title>{title}</title>
  </head>

  <body>
    <slot name="intro" />

    <a class="skip-link" href="#conteudo">{siteContent.skipLink}</a>

    <slot name="header" />

    <main id="conteudo" tabindex="-1">
      <slot />
    </main>

    <slot name="footer" />
  </body>
</html>
