---
import { Image } from 'astro:assets';
import heroCover from '../../assets/images/heroimg.png';
import personalLogo from '../../assets/images/logopersonal2.svg';
import type { HeroContent } from '../../content';
import HeroCard from '../react/islands/HeroCard';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section id="hero" class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-kicker">{content.kicker}</p>

    <div class="hero-title-lockup">
      <Image src={personalLogo} alt="" class="hero-logo" aria-hidden="true" />
      <h1 id="hero-title">{content.title}</h1>
    </div>

    <p class="hero-text">{content.description}</p>

    <div class="hero-actions" aria-label={content.actionsAriaLabel}>
      <a
        class="action ps-control ps-control-cross"
        href={content.actions.projects.href}
        aria-label={content.actions.projects.ariaLabel}
        aria-keyshortcuts="X"
        data-shortcut="x"
        data-sound="confirm"
      >
        <span class="ps-symbol" aria-hidden="true">×</span>
        <span>{content.actions.projects.label}</span>
      </a>

      <a
        class="action ps-control ps-control-triangle"
        href={content.actions.contact.href}
        aria-label={content.actions.contact.ariaLabel}
        aria-keyshortcuts="A ArrowUp"
        data-shortcut="a"
        data-sound="option"
      >
        <span class="ps-symbol" aria-hidden="true">△</span>
        <span>{content.actions.contact.label}</span>
      </a>
    </div>
  </div>

  <HeroCard client:idle figureAriaLabel={content.image.figureAriaLabel}>
    <Image
      src={heroCover}
      alt={content.image.alt}
      class="hero-cover-image"
      widths={[320, 480, 640, 768]}
      sizes="(max-width: 54rem) min(78vw, 24rem), min(26vw, 24rem)"
      priority
    />
  </HeroCard>
</section>

<style>
  .hero {
    display: grid;
    min-height: 100svh;
    grid-template-columns: minmax(0, 1.02fr) minmax(18rem, 0.78fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-left: 1px solid rgb(95 218 255 / 0.32);
    border-radius: 0 1rem 1rem 0;
    background: linear-gradient(90deg, rgb(15 10 29 / 0.42), rgb(15 10 29 / 0.12));
    box-shadow:
      inset 1px 0 rgb(168 239 255 / 0.08),
      0 1.5rem 4rem rgb(5 3 13 / 0.18);
    backdrop-filter: blur(2px);
  }

  .hero-kicker {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 0.78rem + 0.55vw, 1.25rem);
    line-height: 1.3;
    text-shadow: 0 0 1rem rgb(0 229 255 / 0.32);
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.4rem + 4vw, 4.75rem);
    font-weight: 700;
    line-height: 0.98;
    text-shadow:
      0 0 0.75rem rgb(55 216 255 / 0.38),
      0 0 2rem rgb(126 91 176 / 0.42);
  }

  .hero-title-lockup {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin-block: 0.5rem 1rem;
  }

  .hero-logo {
    width: clamp(3.25rem, 7vw, 5.25rem);
    height: auto;
    flex: 0 0 auto;
    filter: drop-shadow(0 0 1rem rgb(108 92 231 / 0.32));
  }

  .hero-text {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 0.93rem + 0.5vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3.2rem);
    margin-top: clamp(1.8rem, 4vw, 3rem);
  }

  .action {
    flex: 0 0 auto;
  }

  @media (max-width: 54rem) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      padding-block: clamp(3rem, 12vw, 5rem);
    }

    .hero-copy {
      padding: clamp(1rem, 5vw, 1.5rem);
    }

    h1 {
      max-width: 100%;
    }
  }

  @media (max-width: 30rem) {
    .hero-actions {
      gap: 1rem 1.5rem;
    }
  }
</style>
