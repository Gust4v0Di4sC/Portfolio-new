---
import { BriefcaseBusiness, Building, CalendarDays } from '@lucide/astro';

const experiences = [
  {
    role: 'TODO: cargo atual',
    company: 'TODO: empresa ou contratante',
    period: 'TODO: período',
    summary:
      'Substitua este texto por um resumo real da experiência, destacando responsabilidades, impacto e contexto técnico.',
    tags: ['HTML', 'CSS', 'JavaScript', 'Suporte', 'UI'],
  },
  {
    role: 'TODO: experiência anterior',
    company: 'TODO: empresa',
    period: 'TODO: período',
    summary:
      'Use este espaço para uma segunda experiência profissional, estágio, freelance ou atuação relevante.',
    tags: ['React', 'TypeScript', 'Git', 'Design'],
  },
];
---

<section
  id="experiencia"
  class="experience section-shell container"
  aria-labelledby="experiencia-title"
>
  <div class="section-heading">
    <p>Version Information</p>
    <h2 id="experiencia-title">Experiência</h2>
  </div>

  <ol class="timeline" aria-label="Linha do tempo profissional">
    {
      experiences.map((experience) => (
        <li>
          <article class="experience-card">
            <span class="experience-icon" aria-hidden="true">
              <BriefcaseBusiness size={20} stroke-width={1.7} />
            </span>

            <div class="experience-content">
              <div class="experience-topline">
                <div>
                  <h3>{experience.role}</h3>
                  <p>
                    <Building size={14} stroke-width={1.7} aria-hidden="true" />
                    {experience.company}
                  </p>
                </div>
                <time>
                  <CalendarDays size={14} stroke-width={1.7} aria-hidden="true" />
                  {experience.period}
                </time>
              </div>

              <p class="experience-summary">{experience.summary}</p>

              <ul class="tag-list" aria-label="Tecnologias e temas">
                {experience.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .experience {
    padding-top: clamp(4rem, 10vw, 8rem);
  }

  .section-heading {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin-bottom: var(--space-content);
    text-align: center;
  }

  .section-heading p {
    color: var(--color-focus);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    letter-spacing: 0.08em;
  }

  .timeline {
    position: relative;
    display: grid;
    max-width: 50rem;
    gap: 1.5rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .timeline::before {
    position: absolute;
    inset-block: 1.25rem;
    left: -1.5rem;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--color-primary), transparent);
    content: '';
    opacity: 0.45;
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li::before {
    position: absolute;
    top: 1.45rem;
    left: -1.75rem;
    width: 0.5rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--color-primary-intense);
    box-shadow: 0 0 1rem var(--color-primary-intense);
    content: '';
  }

  .experience-card {
    display: grid;
    grid-template-columns: 2.7rem minmax(0, 1fr);
    gap: 1rem;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: linear-gradient(180deg, rgb(7 17 31 / 0.74), rgb(2 6 13 / 0.82));
    box-shadow: var(--shadow-glow-soft);
  }

  .experience-icon {
    display: grid;
    width: 2.7rem;
    aspect-ratio: 1;
    place-items: center;
    align-self: start;
    border: 1px solid rgb(34 211 238 / 0.22);
    border-radius: var(--radius-small);
    color: var(--color-primary-intense);
    background: rgb(2 6 13 / 0.72);
    box-shadow:
      0 0 1rem rgb(34 211 238 / 0.08),
      inset 0 0 0.8rem rgb(34 211 238 / 0.06);
  }

  .experience-content {
    min-width: 0;
  }

  .experience-topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    color: var(--color-text);
    font-size: clamp(1rem, 0.94rem + 0.35vw, 1.2rem);
    font-weight: 700;
  }

  .experience-topline p,
  time {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step-small);
  }

  time {
    color: var(--color-primary);
    white-space: nowrap;
  }

  .experience-summary {
    margin-top: 1rem;
    color: var(--color-text-muted);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 0.25rem 0.55rem;
    border: 1px solid rgb(34 211 238 / 0.18);
    border-radius: var(--radius-small);
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: rgb(34 211 238 / 0.05);
  }

  @media (max-width: 42rem) {
    .timeline::before,
    .timeline > li::before {
      display: none;
    }

    .experience-topline {
      display: grid;
    }

    .experience-card {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      gap: 0.8rem;
    }

    .experience-icon {
      width: 2.4rem;
    }
  }
</style>
