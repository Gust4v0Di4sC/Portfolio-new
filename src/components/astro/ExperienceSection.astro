---
import { BriefcaseBusiness, Building, CalendarDays } from '@lucide/astro';
import type { ExperienceContent } from '../../content';

interface Props {
  content: ExperienceContent;
}

const { content } = Astro.props;
---

<section
  id="experiencia"
  class="experience section-shell container"
  aria-labelledby="experiencia-title"
>
  <div class="section-heading">
    <p>{content.eyebrow}</p>
    <h1 id="experiencia-title">{content.title}</h1>
  </div>

  <ol class="timeline" aria-label={content.timelineAriaLabel}>
    {
      content.items.map((experience) => (
        <li>
          <article class="experience-card">
            <span class="experience-icon" aria-hidden="true">
              <BriefcaseBusiness size={20} stroke-width={1.7} />
            </span>

            <div class="experience-content">
              <div class="experience-topline">
                <div>
                  <h2>{experience.role}</h2>
                  <p>
                    <Building size={14} stroke-width={1.7} aria-hidden="true" />
                    {experience.company}
                  </p>
                </div>
                <time>
                  <CalendarDays size={14} stroke-width={1.7} aria-hidden="true" />
                  {experience.period}
                </time>
              </div>

              <p class="experience-summary">{experience.summary}</p>

              <ul class="tag-list" aria-label={content.tagsAriaLabel}>
                {experience.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .experience {
    display: grid;
    max-width: 68rem;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .section-heading {
    display: grid;
    gap: 0.2rem;
    max-width: 58rem;
    margin-inline: auto;
    width: 100%;
  }

  .section-heading p {
    color: #d8e400;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1.1vw, 0.86rem);
    letter-spacing: 0.1em;
    text-shadow: 0 2px 2px rgb(0 0 0 / 0.9);
    text-transform: uppercase;
  }

  .section-heading h1 {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.35rem + 2.4vw, 3.5rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.05;
    text-shadow:
      0 2px 2px rgb(0 0 0 / 0.9),
      0 0 1rem rgb(55 216 255 / 0.2);
  }

  .timeline {
    position: relative;
    display: grid;
    max-width: 58rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .timeline::before {
    position: absolute;
    inset-block: 1.4rem;
    left: 0.3rem;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgb(55 216 255 / 0.52), transparent);
    content: '';
  }

  .timeline > li {
    position: relative;
    padding-left: clamp(2rem, 4vw, 3rem);
  }

  .timeline > li::before {
    position: absolute;
    top: clamp(1.65rem, 3vw, 2.2rem);
    left: 0;
    width: 0.68rem;
    aspect-ratio: 1;
    border: 1px solid rgb(189 247 255 / 0.72);
    border-radius: 999px;
    background: #16264d;
    box-shadow:
      0 0 0.8rem rgb(55 216 255 / 0.58),
      inset 0 0 0.35rem rgb(55 216 255 / 0.74);
    content: '';
  }

  .experience-card {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.85rem;
    padding-block: clamp(1.25rem, 3vw, 1.8rem);
    border-bottom: 1px solid rgb(190 210 255 / 0.12);
  }

  .experience-icon {
    display: grid;
    width: 1.75rem;
    aspect-ratio: 1;
    place-items: center;
    align-self: start;
    margin-top: 0.05rem;
    color: rgb(55 216 255 / 0.84);
  }

  .experience-content {
    min-width: 0;
  }

  .experience-topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .experience-topline h2 {
    color: var(--color-text);
    font-size: clamp(1.05rem, 0.96rem + 0.5vw, 1.35rem);
    font-weight: 500;
    line-height: 1.25;
    text-shadow: 0 2px 2px rgb(0 0 0 / 0.84);
  }

  .experience-topline p,
  time {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--step-small);
  }

  time {
    color: #71dcf5;
    white-space: nowrap;
  }

  .experience-summary {
    max-width: 49rem;
    margin-top: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    margin-top: 0.8rem;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    color: rgb(168 239 255 / 0.78);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .tag-list li:not(:last-child)::after {
    margin-inline: 0.55rem;
    color: rgb(168 239 255 / 0.28);
    content: '/';
  }

  @media (max-width: 42rem) {
    .experience-topline {
      display: grid;
      gap: 0.35rem;
    }

    .experience-card {
      grid-template-columns: 1.4rem minmax(0, 1fr);
      gap: 0.65rem;
    }

    .experience-icon {
      width: 1.4rem;
    }

    .experience-icon :global(svg) {
      width: 1rem;
    }

    .timeline > li {
      padding-left: 1.45rem;
    }

    .timeline > li::before {
      width: 0.55rem;
    }

    .timeline::before {
      left: 0.25rem;
    }
  }
</style>
