---
import { navigationContent as content } from '../../content';
---

<header class="site-header">
  <nav class="site-nav container" aria-label={content.ariaLabel}>
    <a
      class="brand"
      href={content.brand.href}
      aria-label={content.brand.ariaLabel}
      data-sound="confirm"
    >
      <img src="/favicon.svg" alt="" width="44" height="44" aria-hidden="true" />
    </a>

    <ul class="nav-links">
      {
        content.items.map((item) => (
          <li>
            <a href={item.href} data-sound="confirm">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    min-height: var(--header-height);
    border-bottom: 1px solid rgb(34 211 238 / 0.08);
    background: linear-gradient(180deg, rgb(2 6 13 / 0.9), rgb(2 6 13 / 0.64));
    backdrop-filter: blur(16px);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    overflow: hidden;
    padding: 0.2rem;
    border: 1px solid rgb(186 230 253 / 0.16);
    border-radius: 0.65rem;
    background: linear-gradient(135deg, rgb(148 163 184 / 0.92), rgb(71 85 105 / 0.92));
    color: var(--color-primary-intense);
    filter: drop-shadow(0 0 0.5rem rgb(0 229 255 / 0.28));
    transition:
      filter var(--transition-fast),
      transform var(--transition-fast);
  }

  .brand:hover,
  .brand:focus-visible {
    filter: drop-shadow(0 0 0.8rem rgb(0 229 255 / 0.52));
    transform: translateY(-1px);
  }

  .brand img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: clamp(0.35rem, 1vw, 1rem);
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.4rem clamp(0.45rem, 1.2vw, 0.8rem);
    border-radius: var(--radius-small);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    transition:
      color var(--transition-fast),
      text-shadow var(--transition-fast),
      background-color var(--transition-fast);
  }

  .nav-links a:hover {
    color: var(--color-primary);
    background-color: rgb(34 211 238 / 0.06);
    text-shadow: 0 0 0.75rem rgb(0 229 255 / 0.35);
  }

  @media (max-width: 42rem) {
    .site-nav {
      min-height: auto;
      align-items: flex-start;
      flex-direction: column;
      padding-block: 0.9rem;
    }

    .nav-links {
      justify-content: flex-start;
      width: 100%;
    }
  }
</style>
