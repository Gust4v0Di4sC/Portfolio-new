---
import type { AboutContent } from '../../content';

interface Props {
  content: AboutContent;
}

const { content } = Astro.props;
---

<section id="sobre" class="about section-shell container" aria-labelledby="sobre-title">
  <div class="about-panel">
    <header class="about-heading">
      <h1 id="sobre-title">{content.title}</h1>
    </header>
    <div class="about-copy">
      {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about {
    max-width: 68rem;
  }

  .about-panel {
    display: grid;
    max-width: 58rem;
    grid-template-columns: minmax(11rem, 0.62fr) minmax(0, 1.65fr);
    gap: clamp(2rem, 7vw, 6rem);
    margin-inline: auto;
    width: 100%;
  }

  .about-heading {
    position: relative;
    align-self: start;
    padding-left: 1.4rem;
  }

  .about-heading::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: linear-gradient(180deg, #37d8ff, rgb(55 216 255 / 0.08));
    box-shadow: 0 0 0.9rem rgb(55 216 255 / 0.35);
    content: '';
  }

  h1 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.7rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.05;
    text-shadow:
      0 2px 2px rgb(0 0 0 / 0.9),
      0 0 1rem rgb(55 216 255 / 0.2);
  }

  .about-copy {
    display: grid;
    gap: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .about-copy p {
    position: relative;
    margin: 0;
  }

  .about-copy p + p {
    padding-top: 1.2rem;
    border-top: 1px solid rgb(190 210 255 / 0.1);
  }

  @media (max-width: 44rem) {
    .about-panel {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .about-heading {
      padding-left: 1rem;
    }

    .about-copy {
      line-height: 1.65;
    }
  }
</style>
