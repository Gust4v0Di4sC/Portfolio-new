---
import { aboutContent as content } from '../../content';
---

<section id="sobre" class="about section-shell container" aria-labelledby="sobre-title">
  <div class="about-panel">
    <p class="eyebrow">{content.eyebrow}</p>
    <h2 id="sobre-title">{content.title}</h2>
    {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

<style>
  .about-panel {
    display: grid;
    max-width: 48rem;
    gap: 1rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    background: linear-gradient(90deg, rgb(34 211 238 / 0.08), transparent 46%);
  }

  .eyebrow {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: var(--step-small);
  }

  h2 {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.8rem);
    line-height: 1.1;
  }
</style>
