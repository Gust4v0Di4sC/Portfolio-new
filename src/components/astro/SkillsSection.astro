---
import {
  Accessibility,
  AppWindow,
  Atom,
  Braces,
  Cable,
  CloudUpload,
  CodeXml,
  FileType,
  FingerprintPattern,
  FlaskConical,
  Gauge,
  GitBranch,
  LayoutPanelTop,
  ListChecks,
  MousePointerClick,
  Orbit,
  Palette,
  PanelsTopLeft,
  PenTool,
  SearchCheck,
} from '@lucide/astro';

const groups = [
  {
    title: 'Interfaces',
    skills: [
      { name: 'HTML', icon: CodeXml },
      { name: 'CSS', icon: Palette },
      { name: 'Acessibilidade', icon: Accessibility },
      { name: 'Responsividade', icon: PanelsTopLeft },
    ],
  },
  {
    title: 'Frameworks',
    skills: [
      { name: 'Astro', icon: Orbit },
      { name: 'React', icon: Atom },
      { name: 'Next.js', icon: AppWindow },
      { name: 'TypeScript', icon: FileType },
    ],
  },
  {
    title: 'Integrações',
    skills: [
      { name: 'APIs', icon: Cable },
      { name: 'Git', icon: GitBranch },
      { name: 'Deploy', icon: CloudUpload },
      { name: 'SEO', icon: SearchCheck },
    ],
  },
  {
    title: 'Qualidade',
    skills: [
      { name: 'Lint', icon: ListChecks },
      { name: 'Testes', icon: FlaskConical },
      { name: 'Performance', icon: Gauge },
      { name: 'Semântica', icon: Braces },
    ],
  },
  {
    title: 'Design',
    skills: [
      { name: 'UI', icon: LayoutPanelTop },
      { name: 'UX', icon: MousePointerClick },
      { name: 'Figma', icon: PenTool },
      { name: 'Identidade visual', icon: FingerprintPattern },
    ],
  },
];
---

<section
  id="habilidades"
  class="skills section-shell container"
  aria-labelledby="habilidades-title"
>
  <div class="section-heading">
    <p>System Abilities</p>
    <h2 id="habilidades-title">Habilidades</h2>
  </div>

  <div class="skill-grid">
    {
      groups.map((group) => (
        <article class="skill-group">
          <h3>{group.title}</h3>
          <ul>
            {group.skills.map(({ name, icon: Icon }) => (
              <li>
                <span class="skill-icon" aria-hidden="true">
                  <Icon size={18} stroke-width={1.7} />
                </span>
                {name}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .section-heading {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin-bottom: var(--space-content);
    text-align: center;
  }

  .section-heading p {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step-small);
  }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .skill-group {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: rgb(7 17 31 / 0.54);
  }

  .skill-group h3 {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 1rem;
  }

  .skill-group ul {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .skill-group li {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text-muted);
    font-size: var(--step-small);
  }

  .skill-icon {
    display: grid;
    width: 2.3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(34 211 238 / 0.16);
    border-radius: var(--radius-small);
    color: var(--color-primary-intense);
    background: rgb(2 6 13 / 0.72);
    box-shadow: inset 0 0 0.8rem rgb(34 211 238 / 0.05);
  }

  .skill-group:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-glow-soft);
  }

  @media (max-width: 64rem) {
    .skill-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34rem) {
    .skill-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
