---
import { contactContent as content } from '../../content';
---

<section id="contato" class="contact section-shell container" aria-labelledby="contato-title">
  <div class="contact-panel">
    <h2 id="contato-title">{content.title}</h2>
    <p>{content.description}</p>

    <a
      class="email-button ps-control ps-control-cross"
      href={`mailto:${content.email}`}
      aria-keyshortcuts="X"
      data-shortcut="x"
    >
      <span class="ps-symbol" aria-hidden="true">×</span>
      <span>{content.actionLabel}</span>
    </a>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(5rem, 12vw, 9rem);
  }

  .contact-panel {
    display: grid;
    justify-items: center;
    max-width: 38rem;
    gap: 1rem;
    margin-inline: auto;
    padding: clamp(1.6rem, 5vw, 3rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-medium);
    background:
      radial-gradient(circle at 50% 0%, rgb(0 229 255 / 0.12), transparent 18rem),
      rgb(2 6 13 / 0.86);
    box-shadow: var(--shadow-glow-strong);
    text-align: center;
  }

  h2 {
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.8vw, 2rem);
  }

  .contact-panel > p {
    color: var(--color-text-muted);
  }

  .email-button {
    min-height: 2.75rem;
    margin-top: 0.5rem;
    padding-inline: 1rem;
  }
</style>
