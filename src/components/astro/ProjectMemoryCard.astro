---
import type { ProjectsContent } from '../../content';
import ProjectCarousel from '../react/islands/ProjectCarousel';

interface Props {
  content: ProjectsContent;
}

const { content } = Astro.props;
---

<section id="projetos" class="projects section-shell container" aria-labelledby="projetos-title">
  <div class="section-heading">
    <p>{content.eyebrow}</p>
    <h2 id="projetos-title">{content.title}</h2>
  </div>

  <div class="project-browser-slot" aria-label={content.cardAriaLabel}>
    <ProjectCarousel content={content} client:visible />
  </div>
</section>

<style>
  .section-heading {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin-bottom: clamp(0.35rem, 1vh, 0.7rem);
    text-align: center;
  }

  .projects {
    --color-text: #f1f7ff;
    --color-text-muted: #d5e2ef;
    --color-text-subtle: #bed0e1;
    --color-primary: #67e8f9;
    --color-primary-intense: #a5f3fc;
  }

  .section-heading p {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.2vw, 0.82rem);
  }

  .section-heading h2 {
    font-size: clamp(1.3rem, 1rem + 1.5vw, 1.9rem);
  }

  .project-browser-slot {
    width: 100%;
    margin-inline: auto;
  }
</style>
