---
import { projectsContent as content } from '../../content';
import ProjectCarousel from '../react/islands/ProjectCarousel';
---

<section id="projetos" class="projects section-shell container" aria-labelledby="projetos-title">
  <div class="section-heading">
    <p>{content.eyebrow}</p>
    <h2 id="projetos-title">{content.title}</h2>
  </div>

  <article class="memory-card" aria-label={content.cardAriaLabel}>
    <header class="memory-header">
      <div>
        <p>{content.memorySlot}</p>
        <span>{content.status}</span>
      </div>
      <strong
        >{
          content.saveLabel.split(' / ').map((line) => (
            <Fragment>
              {line}
              <br />
            </Fragment>
          ))
        }</strong
      >
    </header>

    <div class="carousel-slot">
      <ProjectCarousel client:visible />
    </div>

    <footer class="memory-actions" aria-label={content.instructionsAriaLabel}>
      {content.instructions.map((instruction) => <span>{instruction}</span>)}
    </footer>
  </article>
</section>

<style>
  .section-heading {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin-bottom: var(--space-content);
    text-align: center;
  }

  .section-heading p {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step-small);
  }

  .memory-card {
    max-width: 62rem;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-medium);
    background:
      linear-gradient(
        90deg,
        rgb(34 211 238 / 0.06),
        transparent 18%,
        transparent 82%,
        rgb(37 99 235 / 0.06)
      ),
      rgb(2 6 13 / 0.78);
    box-shadow: var(--shadow-glow-strong);
  }

  .memory-header,
  .memory-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 3vw, 1.5rem);
    font-family: var(--font-mono);
  }

  .memory-header {
    border-bottom: 1px solid rgb(34 211 238 / 0.12);
  }

  .memory-header p {
    color: var(--color-text);
    font-weight: 700;
  }

  .memory-header span,
  .memory-actions {
    color: var(--color-text-muted);
    font-size: var(--step-small);
  }

  .memory-header strong {
    color: var(--color-primary);
    font-size: var(--step-small);
    line-height: 1.2;
    text-align: right;
  }

  .carousel-slot {
    display: grid;
    justify-items: center;
    padding: clamp(1rem, 4vw, 2rem);
  }

  .memory-actions {
    justify-content: center;
    flex-wrap: wrap;
    min-height: 3.7rem;
    padding-block: 0.7rem;
    border-top: 1px solid rgb(34 211 238 / 0.12);
    text-align: center;
  }

  .memory-actions span + span::before {
    margin-right: 1rem;
    color: var(--color-primary);
    content: '•';
  }

  @media (max-width: 34rem) {
    .memory-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .memory-header strong {
      text-align: left;
    }

    .memory-actions {
      display: grid;
      gap: 0.3rem;
    }

    .memory-actions span + span::before {
      content: none;
    }
  }
</style>
