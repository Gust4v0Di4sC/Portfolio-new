---
import Particles from '../react/Particles';
---

<footer class="site-footer">
  <div class="footer-particles" aria-hidden="true">
    <Particles
      client:visible
      particleColors={['#e0f2fe', '#67e8f9', '#00e5ff', '#2563eb']}
      particleCount={150}
      particleSpread={8}
      speed={0.16}
      particleBaseSize={72}
      sizeRandomness={1.2}
      cameraDistance={18}
      alphaParticles={true}
    />
  </div>

  <div class="container footer-inner">
    <div>
      <p>Desenvolvido por Gustavo Dias.</p>
      <p class="footer-note">Inspirado pela atmosfera da era PS2, sem afiliação oficial.</p>
    </div>

    <p class="footer-socials">TODO: adicionar links sociais reais.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    min-height: 13rem;
    overflow: hidden;
    padding-block: clamp(2rem, 6vw, 4rem);
    border-top: 1px solid rgb(34 211 238 / 0.12);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    background: linear-gradient(180deg, rgb(2 6 13 / 0.42), rgb(2 6 13 / 0.92));
  }

  .footer-particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.68;
    mask-image: linear-gradient(to bottom, transparent, #000 24%, #000);
    pointer-events: none;
  }

  .footer-particles :global(astro-island) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .footer-note {
    color: rgb(156 176 195 / 0.68);
  }

  .footer-socials {
    color: var(--color-primary);
  }

  @media (max-width: 42rem) {
    .footer-inner {
      justify-content: center;
      text-align: center;
    }
  }
</style>
