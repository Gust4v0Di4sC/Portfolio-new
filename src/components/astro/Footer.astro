---
import { ContactRound, GitFork } from '@lucide/astro';
import Particles from '../react/Particles';
---

<footer class="site-footer">
  <div class="footer-particles" aria-hidden="true">
    <Particles
      client:visible
      particleColors={['#e0f2fe', '#67e8f9', '#00e5ff', '#2563eb']}
      particleCount={150}
      particleSpread={8}
      speed={0.16}
      particleBaseSize={72}
      sizeRandomness={1.2}
      cameraDistance={18}
      alphaParticles={true}
    />
  </div>

  <div class="container footer-inner">
    <div>
      <p>Desenvolvido por Gustavo Dias.</p>
      <p class="footer-note">Inspirado pela atmosfera da era PS2, sem afiliação oficial.</p>
    </div>

    <nav class="footer-socials" aria-label="Redes sociais">
      <a
        href="https://www.linkedin.com/in/gustavo-dias-charra/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar LinkedIn de Gustavo Dias (abre em nova aba)"
      >
        <span aria-hidden="true">
          <ContactRound size={17} stroke-width={1.7} />
        </span>
        LinkedIn
      </a>
      <a
        href="https://github.com/Gust4v0Di4sC"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar GitHub de Gustavo Dias (abre em nova aba)"
      >
        <span aria-hidden="true">
          <GitFork size={17} stroke-width={1.7} />
        </span>
        GitHub
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    min-height: 13rem;
    overflow: hidden;
    padding-block: clamp(2rem, 6vw, 4rem);
    border-top: 1px solid rgb(34 211 238 / 0.12);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    background: linear-gradient(180deg, rgb(2 6 13 / 0.42), rgb(2 6 13 / 0.92));
  }

  .footer-particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.68;
    mask-image: linear-gradient(to bottom, transparent, #000 24%, #000);
    pointer-events: none;
  }

  .footer-particles :global(astro-island) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .footer-note {
    color: rgb(156 176 195 / 0.68);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .footer-socials a {
    display: inline-flex;
    min-height: 2.4rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.65rem 0.35rem 0.4rem;
    border: 1px solid rgb(34 211 238 / 0.18);
    border-radius: var(--radius-small);
    color: var(--color-primary);
    background: rgb(2 6 13 / 0.68);
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .footer-socials a span {
    display: grid;
    width: 1.75rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(34 211 238 / 0.2);
    border-radius: var(--radius-small);
    color: var(--color-primary-intense);
    background: rgb(7 17 31 / 0.72);
    box-shadow: inset 0 0 0.65rem rgb(34 211 238 / 0.06);
  }

  .footer-socials a:hover,
  .footer-socials a:focus-visible {
    transform: translateY(-0.125rem);
    border-color: var(--color-border-strong);
    color: var(--color-text);
    box-shadow: var(--shadow-glow-soft);
  }

  @media (max-width: 42rem) {
    .footer-inner {
      justify-content: center;
      text-align: center;
    }

    .footer-socials {
      justify-content: center;
    }
  }
</style>
