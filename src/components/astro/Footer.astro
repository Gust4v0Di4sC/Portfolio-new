---
import { footerContent as content } from '../../content';
import Particles from '../react/islands/Particles';
---

<footer class="site-footer">
  <div class="footer-particles" aria-hidden="true">
    <Particles
      client:visible
      particleColors={['#e0f2fe', '#67e8f9', '#00e5ff', '#2563eb']}
      particleCount={150}
      particleSpread={8}
      speed={0.16}
      particleBaseSize={72}
      sizeRandomness={1.2}
      cameraDistance={18}
      alphaParticles={true}
    />
  </div>

  <div class="container footer-inner">
    <p>{content.credit}</p>

    <nav class="footer-socials" aria-label={content.socialsAriaLabel}>
      {
        content.socials.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.ariaLabel}
          >
            <img class={social.iconClass} src={social.icon} alt="" width="24" height="24" />
            {social.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    min-height: 13rem;
    overflow: hidden;
    padding-block: clamp(2rem, 6vw, 4rem);
    border-top: 1px solid rgb(34 211 238 / 0.12);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--step-small);
    background: linear-gradient(180deg, rgb(2 6 13 / 0.42), rgb(2 6 13 / 0.92));
  }

  .footer-particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.68;
    mask-image: linear-gradient(to bottom, transparent, #000 24%, #000);
    pointer-events: none;
  }

  .footer-particles :global(astro-island) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .footer-socials a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.2rem;
    color: var(--color-primary);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .footer-socials img {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
    transition:
      filter var(--transition-fast),
      transform var(--transition-fast);
  }

  .footer-socials .github-icon {
    filter: invert(1);
  }

  .footer-socials a:hover,
  .footer-socials a:focus-visible {
    transform: translateY(-0.125rem);
    color: var(--color-text);
  }

  .footer-socials a:hover img,
  .footer-socials a:focus-visible img {
    transform: scale(1.08);
    filter: drop-shadow(0 0 0.45rem rgb(34 211 238 / 0.55));
  }

  .footer-socials a:hover .github-icon,
  .footer-socials a:focus-visible .github-icon {
    filter: invert(1) drop-shadow(0 0 0.45rem rgb(34 211 238 / 0.55));
  }

  @media (max-width: 42rem) {
    .footer-inner {
      justify-content: center;
      text-align: center;
    }

    .footer-socials {
      justify-content: center;
    }
  }
</style>
