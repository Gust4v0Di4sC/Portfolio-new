---
import AboutSection from '../components/astro/AboutSection.astro';
import ContactSection from '../components/astro/ContactSection.astro';
import ExperienceSection from '../components/astro/ExperienceSection.astro';
import Footer from '../components/astro/Footer.astro';
import Header from '../components/astro/Header.astro';
import Hero from '../components/astro/Hero.astro';
import ProjectMemoryCard from '../components/astro/ProjectMemoryCard.astro';
import SkillsSection from '../components/astro/SkillsSection.astro';
import InterfaceController from '../components/react/InterfaceController';
import ScrollBackground from '../components/react/ScrollBackground';
import SplashIntro from '../components/react/SplashIntro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Gustavo Dias - Desenvolvedor Front-end"
  description="Portfólio de Gustavo Dias, desenvolvedor Front-end e UI/UX Designer."
>
  <SplashIntro slot="intro" client:load />
  <Header slot="header" />

  <ScrollBackground client:load />
  <Hero />

  <ExperienceSection />
  <ProjectMemoryCard />
  <SkillsSection />
  <AboutSection />
  <ContactSection />
  <InterfaceController client:load />

  <Footer slot="footer" />
</BaseLayout>
